# Copie este arquivo para ".env" e preencha os valores.
# O ".env" NUNCA deve ser enviado ao GitHub (já está no .gitignore).

# --- Servidor ---
HOST=0.0.0.0
PORT=8080

# --- Autenticação ---
# Gere um token forte, por exemplo com: openssl rand -hex 24
AUTH_TOKEN=troque-por-um-token-forte-aqui
# Nunca deixe true em produção — só serve pra testar localmente sem token.
ALLOW_NO_AUTH=false

# --- Sincronização com o GitHub ---
GIT_UPDATE_INTERVAL=60

# --- Histórico ---
HISTORY_SAMPLE_INTERVAL=15
HISTORY_RETENTION_HOURS=24

# --- Minecraft ---
MC_HOST=127.0.0.1
MC_PORT=25565
# Caminho da pasta do servidor Minecraft no celular (pra ler tamanho em disco e logs)
MC_SERVER_DIR=/data/data/com.termux/files/home/minecraft-server
# RCON é opcional — só preencha se quiser TPS. Habilite enable-rcon=true
# no server.properties do Minecraft e defina a mesma senha aqui.
MC_RCON_HOST=127.0.0.1
MC_RCON_PORT=25575
MC_RCON_PASSWORD=

# --- Alertas ---
ALERT_CPU_PERCENT=90
ALERT_RAM_PERCENT=85
ALERT_STORAGE_PERCENT=85
ALERT_BATTERY_LOW=15
ALERT_TEMP_CELSIUS=45

# --- Rede ---
PING_HOST=8.8.8.8
